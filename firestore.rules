rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isBanned() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    function notBanned() {
      return isSignedIn() && !isBanned();
    }

    function onlyKeysChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isAuthor() {
      return isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    function isPublishingScheduled() {
      return resource.data.status == 'scheduled'
        && request.resource.data.status == 'published'
        && resource.data.scheduledFor != null;
    }

    function isEngagementCountUpdate() {
      return onlyKeysChanged(['likeCount'])
        || onlyKeysChanged(['commentCount'])
        || onlyKeysChanged(['shareCount'])
        || onlyKeysChanged(['viewCount']);
    }

    // Admin list — admins can manage roles
    match /admins/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /banned/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /presence/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin()
        || (isAuthor() && onlyKeysChanged(['title', 'text', 'updatedAt']))
        || isPublishingScheduled()
        || isEngagementCountUpdate()
      );
      allow delete: if isAdmin() || (isSignedIn() && isAuthor());

      match /likes/{uid} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSignedIn() && (
          isAdmin()
          || (resource.data.authorUid == request.auth.uid && onlyKeysChanged(['reactions']))
        );
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }

      match /shares/{uid} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.read == false;
      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid
        && onlyKeysChanged(['read']);
      allow delete: if isAdmin();
    }

    match /flags/{flagId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /followers/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.followerUid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerUid == request.auth.uid;
    }

    match /closeFriends/{closeFriendId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.friendUid is string;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /hashtags/{tag} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /mentions/{mentionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /saves/{saveId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /bookmarkCollections/{collectionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /postViews/{viewId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /pushTokens/{tokenId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /reactions/{reactionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /storyHighlights/{highlightId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
    }

    match /userFlags/{flagId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /adminActions/{actionId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /conversations/{convId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create, update: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && request.resource.data.senderUid == request.auth.uid;
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && resource.data.senderUid != request.auth.uid
          && onlyKeysChanged(['read', 'delivered']);
      }
    }

    // Monetization collections
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && onlyKeysChanged(['status', 'cancelAtPeriodEnd']);
      allow delete: if isAdmin();
    }

    match /creator_analytics/{analyticsId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /brand_campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /campaign_applications/{appId} {
      allow read: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.creatorUid == request.auth.uid);
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
