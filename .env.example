# Firebase Configuration
# Copy this file to .env and fill in your values
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ImgBB API Key (optional - for image uploads)
VITE_IMGBB_API_KEY=your_imgbb_api_key

# Till Number Payment Configuration
# IMPORTANT: Add your actual Till Number and account name here
# Do not commit the actual .env file with real payment details
VITE_TILL_NUMBER=your_till_number
VITE_TILL_ACCOUNT_NAME=your_business_name

# Environment
VITE_ENV=development
